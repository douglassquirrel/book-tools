#!/usr/bin/env python3
"""sources-to-text: every source file in a folder to searchable text."""

import os
import sys

# Never write __pycache__, here or anywhere a book is kept.
sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from booktools.sources_to_text import main  # noqa: E402

sys.exit(main())
